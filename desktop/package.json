{
  "name": "theboss-cut",
  "productName": "THEBOSS CUT",
  "version": "1.0.0",
  "description": "O editor de vídeo do THEBOSSVERSE",
  "author": "THEBOSSVERSE",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.thebossverse.cut",
    "productName": "THEBOSS CUT",
    "copyright": "THEBOSSVERSE",
    "directories": { "output": "dist" },
    "files": ["main.js", "atualizacao.js", "preload.js", "carregando.html", "icone.png", "emblema.webm"],
    "extraResources": [{ "from": "app", "to": "app" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icone.png",
      "artifactName": "THEBOSS-CUT-Instalador.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "THEBOSS CUT"
    }
  }
}
